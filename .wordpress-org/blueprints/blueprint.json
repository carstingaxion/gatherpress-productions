{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/edit.php?post_type=gatherpress_play",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "GatherPress Productions",
        "blogdescription": "Enhancing GatherPress with Theater Productions.",
        "users_can_register": 1,
        "permalink_structure": "/%year%/%monthnum%/%postname%/"
      }
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
          "GATHERPRESS_ALPHA_VERSION": 1
      }
    },
    {
      "step": "login",
      "username": "admin"
    },
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/carstingaxion/gatherpress-productions/refs/heads/main/.wordpress-org/blueprints/gatherpress.zip"
			},
      "options": {
          "activate": true
      }
		},
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/carstingaxion/gatherpress-productions",
        "ref": "HEAD"
      },
      "options": {
        "activate": true
      },
      "progress": {
        "caption": "Installing plugin from GitHub: carstingaxion/gatherpress-productions"
      }
    }
  ]
}
